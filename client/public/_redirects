# Netlify redirect rules - simplified to avoid redirect chains

# Force HTTPS and www to non-www in single redirect
http://www.villafiscardo.com/* https://villafiscardo.com/:splat 301!
https://www.villafiscardo.com/* https://villafiscardo.com/:splat 301!
http://villafiscardo.com/* https://villafiscardo.com/:splat 301!

# Remove blog canonical HTML redirects - let React handle routing
# These were creating redirect chains and indexing issues

# Static SEO pages should redirect to main site sections
/fiscardo-villa.html / 301!
/fiscardo-villas.html / 301!
/villa / 301!
/Villa / 301!

# Remove standalone canonical HTML pages - they shouldn't be indexed separately
/beach-exploration-canonical.html /blog/beach-exploration 301!
/culinary-delights-canonical.html /blog/culinary-delights 301!
/nature-hikes-canonical.html /blog/nature-hikes 301!